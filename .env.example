# PodRipper Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS
# =============================================================================

# Anthropic (Claude) - Recommended for best quality summaries
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI - Alternative for transcription and summarization
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================

# Which LLM provider to use for cleaning and summarization
# Options: anthropic, openai, ollama
LLM_PROVIDER=anthropic

# Ollama Configuration (for local LLM)
# Only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# =============================================================================
# TRANSCRIPTION CONFIGURATION
# =============================================================================

# Which transcription provider to use
# Options: whisper (local), openai (cloud API)
TRANSCRIPTION_PROVIDER=whisper

# Whisper Model (only used if TRANSCRIPTION_PROVIDER=whisper)
# Options: tiny, base, small, medium, large
# tiny: Fastest, lowest quality, ~1GB RAM
# base: Good balance, recommended for most users, ~1GB RAM
# small: Better quality, ~2GB RAM
# medium: High quality, ~5GB RAM
# large: Best quality, requires GPU, ~10GB RAM
WHISPER_MODEL=base

# =============================================================================
# FILE PATHS
# =============================================================================

# Database location
DATABASE_PATH=data/podcasts.duckdb

# Audio files directory
AUDIO_DIR=data/audio

# Transcripts directory
TRANSCRIPTS_DIR=data/transcripts

# Summaries directory
SUMMARIES_DIR=data/summaries

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=data/podripper.log
